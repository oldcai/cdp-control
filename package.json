{
  "name": "cdp-control",
  "version": "1.0.0",
  "private": true,
  "description": "通过 Chrome DevTools Protocol (CDP) 控制本地浏览器的 CLI(取代 chrome-devtools MCP)。全 TS + esbuild 编译到 dist/ 运行。",
  "bin": {
    "cdp-control": "./dist/cdp.js"
  },
  "files": [
    "dist",
    "rules",
    "skills"
  ],
  "engines": {
    "node": ">=22.6.0"
  },
  "scripts": {
    "build": "node build.mjs",
    "prepare": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node test.mjs",
    "test:integration": "node test-integration.mjs",
    "test:pack": "node scripts/pack-smoke.mjs",
    "publish:dry-run": "node scripts/publish-dry-run.mjs",
    "lint": "biome check --error-on-warnings . && node scripts/check-dependencies.mjs && tsc --noEmit && tsc --noEmit --project tsconfig.integration.json",
    "format": "biome format --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@types/node": "^22.10.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "commander": "^12.1.0"
  }
}
